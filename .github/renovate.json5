{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>mmalyska/renovate-config',
    'github>mmalyska/renovate-config:automerge-github-actions',
    'github>mmalyska/renovate-config:automerge-docker-digest',
  ],
  gitAuthor: 'bendo-bot <126472327+bendo-bot[bot]@users.noreply.github.com>',
  customManagers: [
    {
      customType: 'regex',
      description: 'Update azerothcore module commit SHAs',
      managerFilePatterns: [
        '/apps/azerothcore-worldserver/Dockerfile/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\nARG [A-Z_]+=(?<currentDigest>[0-9a-f]{40})',
      ],
      currentValueTemplate: 'master',
      versioningTemplate: 'loose',
    },
  ],
  customDatasources: {
    // talosctl and cilium in dev-workstation must equal the versions pinned in
    // home-ops, so home-ops is their source of truth instead of upstream releases.
    'home-ops-talos': {
      defaultRegistryUrlTemplate: 'https://raw.githubusercontent.com/mmalyska/home-ops/main/.taskfiles/talos/Taskfile.yaml',
      format: 'yaml',
      transformTemplates: [
        '{"releases": [{"version": vars.TALOS_VERSION}]}',
      ],
    },
    'home-ops-cilium': {
      defaultRegistryUrlTemplate: 'https://raw.githubusercontent.com/mmalyska/home-ops/main/.taskfiles/cilium.yml',
      format: 'yaml',
      transformTemplates: [
        '{"releases": [{"version": vars.CILIUM_VERSION}]}',
      ],
    },
  },
  'pip-compile': {
    managerFilePatterns: [
      '/^apps/dev-workstation/python/requirements\\.txt$/',
    ],
  },
  packageRules: [
    {
      description: 'Auto merge patch updates',
      matchUpdateTypes: [
        'patch',
      ],
      automerge: true,
      automergeType: 'pr',
      minimumReleaseAge: '3 days',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      commitMessagePrefix: '📣 ',
      automergeType: 'pr',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      groupName: 'azerothcore wow images',
      matchPackageNames: [
        '/^acore/ac-wotlk-/',
      ],
    },
    {
      matchDatasources: [
        'git-refs',
      ],
      groupName: 'azerothcore wow images',
      matchPackageNames: [
        '/azerothcore/mod-/',
      ],
    },
    {
      description: 'The home-ops pins carry no release date, so a release age would hold them forever',
      matchDatasources: [
        'custom.home-ops-talos',
        'custom.home-ops-cilium',
      ],
      minimumReleaseAge: null,
    },
    {
      description: 'pip-compile owns this lock file: pip_requirements would raise a PR per locked package',
      matchManagers: [
        'pip_requirements',
      ],
      matchFileNames: [
        'apps/dev-workstation/python/**',
      ],
      enabled: false,
    },
    {
      description: 'Compile the dev-workstation lock file for the Python of its base image',
      matchManagers: [
        'pip-compile',
      ],
      matchFileNames: [
        'apps/dev-workstation/python/**',
      ],
      constraints: {
        python: '=3.15.2',
      },
    },
  ],
}
