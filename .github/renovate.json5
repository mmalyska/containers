{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>mmalyska/renovate-config',
    'github>mmalyska/renovate-config:automerge-github-actions',
    'github>mmalyska/renovate-config:automerge-docker-digest',
  ],
  gitAuthor: 'bendo-bot <126472327+bendo-bot[bot]@users.noreply.github.com>',
  customManagers: [
    {
      customType: 'regex',
      description: 'Update azerothcore module commit SHAs',
      managerFilePatterns: [
        '/apps/azerothcore-worldserver/Dockerfile/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\nARG [A-Z_]+=(?<currentDigest>[0-9a-f]{40})',
      ],
      currentValueTemplate: 'master',
      versioningTemplate: 'loose',
    },
  ],
  packageRules: [
    {
      description: 'Auto merge patch updates',
      matchUpdateTypes: [
        'patch',
      ],
      automerge: true,
      automergeType: 'pr',
      minimumReleaseAge: '3 days',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      commitMessagePrefix: '📣 ',
      automergeType: 'pr',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      groupName: 'azerothcore wow images',
      matchPackageNames: [
        '/^acore/ac-wotlk-/',
      ],
    },
    {
      matchDatasources: [
        'git-refs',
      ],
      groupName: 'azerothcore wow images',
      matchPackageNames: [
        '/azerothcore/mod-/',
      ],
    },
    {
      description: 'Every dev-workstation tool bump is a full rebuild and a new digest, so bump them together once a week',
      matchFileNames: [
        'apps/dev-workstation/**',
      ],
      matchDatasources: [
        '!docker',
      ],
      matchPackageNames: [
        '!goss-org/goss',
      ],
      groupName: 'dev-workstation tools',
      schedule: [
        'before 6am on monday',
      ],
    },
    {
      description: 'Bump goss in apps/dev-workstation/mise.toml, action-image-build.yaml and Taskfile.yml in one PR',
      matchPackageNames: [
        'goss-org/goss',
      ],
      groupName: 'goss',
    },
    {
      description: 'mise conda: tools come from conda-forge, and the Anaconda API needs the channel in the URL',
      matchManagers: [
        'mise',
      ],
      matchDatasources: [
        'conda',
      ],
      registryUrls: [
        'https://api.anaconda.org/package/conda-forge',
      ],
    },
  ],
}
