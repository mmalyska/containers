{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>mmalyska/renovate-config',
    'github>mmalyska/renovate-config:automerge-github-actions',
    'github>mmalyska/renovate-config:automerge-docker-digest',
  ],
  gitAuthor: 'bendo-bot <126472327+bendo-bot[bot]@users.noreply.github.com>',
  customManagers: [
    {
      customType: 'regex',
      description: 'Update azerothcore module commit SHAs',
      managerFilePatterns: [
        '/apps/azerothcore-worldserver/Dockerfile/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\nARG [A-Z_]+=(?<currentDigest>[0-9a-f]{40})',
      ],
      currentValueTemplate: 'master',
      versioningTemplate: 'loose',
    },
  ],
  packageRules: [
    {
      description: 'Auto merge patch updates',
      matchUpdateTypes: [
        'patch',
      ],
      automerge: true,
      automergeType: 'pr',
      minimumReleaseAge: '3 days',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      commitMessagePrefix: '📣 ',
      automergeType: 'pr',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      groupName: 'azerothcore wow images',
      matchPackageNames: [
        '/^acore/ac-wotlk-/',
      ],
    },
    {
      matchDatasources: [
        'git-refs',
      ],
      groupName: 'azerothcore wow images',
      matchPackageNames: [
        '/azerothcore/mod-/',
      ],
    },
    {
      description: 'dev-workstation stays on Ubuntu 24.04, matching the devcontainer it replaces',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ubuntu',
      ],
      matchFileNames: [
        'apps/dev-workstation/Dockerfile',
      ],
      allowedVersions: '/^24\\./',
    },
    {
      description: 'Bump goss in apps/dev-workstation/mise.toml, action-image-build.yaml and Taskfile.yml in one PR',
      matchPackageNames: [
        'goss-org/goss',
      ],
      groupName: 'goss',
    },
  ],
}
